#pragma once
//
// Copy this file to include/secrets.h and fill in your values.
// include/secrets.h is gitignored — never commit the real token.
//
//   cp include/secrets.h.example include/secrets.h
//
// The HA long-lived access token grants FULL control of your Home Assistant
// instance. Create one at:
//   http://192.168.1.117:8123/profile/security  ->  "Long-lived access tokens"
//

// ── Home Assistant ───────────────────────────────────────
#define HA_HOST   "192.168.1.117"
#define HA_PORT   8123
#define HA_TOKEN  "paste-your-long-lived-access-token-here"

// ── Entity IDs ───────────────────────────────────────────
// Find the exact IDs with:
//   curl -s -H "Authorization: Bearer $TOKEN" \
//     http://192.168.1.117:8123/api/states \
//     | python3 -c 'import json,sys; [print(e["entity_id"]) for e in json.load(sys.stdin) if e["entity_id"].startswith(("light.","climate."))]'
#define ENT_BULB1 "light.tradfri_bulb_1"
#define ENT_BULB2 "light.tradfri_bulb_2"
#define ENT_BULB3 "light.tradfri_bulb_3"
#define ENT_AC    "climate.sensibo_sky"

// Row labels as shown on screen. Keep short — they share the row's top line
// with the right-aligned state text (font 1, 6px/char, ~200px usable).
#define NAME_BULB1 "TRADFRI BULB 1"
#define NAME_BULB2 "TRADFRI BULB 2"
#define NAME_BULB3 "TRADFRI BULB 3"
#define NAME_AC    "SENSIBO SKY AC"

// ── Wi-Fi ────────────────────────────────────────────────
// Leave both empty to use the WiFiManager captive portal instead: the device
// opens an AP named by AP_PORTAL_NAME (config.h) on first boot / when it can't
// reconnect, and you enter credentials from a phone.
#define WIFI_SSID ""
#define WIFI_PASS ""
